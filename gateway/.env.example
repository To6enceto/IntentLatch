# Local development values. Copy to gateway/.env (git-ignored) and adjust.
INTENTLATCH_DATABASE_URL=postgresql://intentlatch:intentlatch@localhost:5432/intentlatch
# The cluster's Ollama, reached through: kubectl port-forward -n upstreams svc/ollama 11434:11434
INTENTLATCH_OLLAMA_URL=http://localhost:11434
INTENTLATCH_MODEL_A=qwen2.5:3b
INTENTLATCH_MODEL_B=llama3.2:1b
INTENTLATCH_UPSTREAM_TIMEOUT_SECONDS=120
# Required secrets, 32+ characters each. Generate each one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing the signing key invalidates every employee token.
INTENTLATCH_TOKEN_SIGNING_KEY=
INTENTLATCH_ADMIN_API_KEY=
